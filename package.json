{
  "name": "pitcrew-cli",
  "version": "0.1.0",
  "description": "A local pit wall for your coding agents: watch every Claude Code session live, talk to it, and send in the crew (QA, review, security, tests).",
  "keywords": [
    "claude-code",
    "claude",
    "coding-agents",
    "ai-agents",
    "dashboard",
    "local-first",
    "developer-tools",
    "cli"
  ],
  "homepage": "https://github.com/helloupendra/pitcrew#readme",
  "bugs": {
    "url": "https://github.com/helloupendra/pitcrew/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helloupendra/pitcrew.git"
  },
  "license": "MIT",
  "author": "Upendra Singh Chauhan",
  "type": "module",
  "bin": {
    "pitcrew": "dist/cli.js"
  },
  "files": [
    "dist",
    "crew",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "start": "node dist/cli.js",
    "demo": "node dist/cli.js --demo",
    "dev:web": "vite",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^3.0.5"
  }
}
