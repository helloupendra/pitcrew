{
  "name": "pitcrew",
  "version": "0.1.0",
  "description": "Your pit crew of coding agents. A local pit wall that shows every Claude Code session live, on your own machine.",
  "keywords": [
    "claude-code",
    "coding-agents",
    "dashboard",
    "local-first",
    "developer-tools"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "pitcrew": "dist/cli.js"
  },
  "files": [
    "dist",
    "crew",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "start": "node dist/cli.js",
    "demo": "node dist/cli.js --demo",
    "dev:web": "vite",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^3.0.5"
  }
}
